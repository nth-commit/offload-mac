#!/bin/bash
# offload — point your tools at whichever Mac should be doing the work.
# https://github.com/<you>/offload   (see README.md)

OFFLOAD_VERSION="0.1.0"

# Resolve the repo root through symlinks (no `readlink -f` on older macOS).
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir=$(cd -P "$(dirname "$_src")" && pwd)
  _src=$(readlink "$_src")
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
OFFLOAD_ROOT=$(cd -P "$(dirname "$_src")/.." && pwd)
unset _src _dir

# shellcheck source=lib/common.sh
. "$OFFLOAD_ROOT/lib/common.sh"
# shellcheck source=lib/detect.sh
. "$OFFLOAD_ROOT/lib/detect.sh"
# shellcheck source=lib/setup.sh
. "$OFFLOAD_ROOT/lib/setup.sh"

PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:$HOME/.docker/bin:/Applications/Docker.app/Contents/Resources/bin"

load_config() {
  cfg_load || die "no config at $OFFLOAD_CONFIG — run install.sh, or copy config.example.toml there"
  mkdir -p "$OFFLOAD_STATE_DIR/targets"
}

# ---------------------------------------------------------------- modules

module_file() {
  local f
  for f in "$OFFLOAD_CONFIG_DIR/modules/$1.sh" "$OFFLOAD_ROOT/modules/$1.sh"; do
    [ -r "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# Helpers available inside modules.
wcfg()      { cfg "$WORKLOAD.$1" "${2:-}"; }
is_local()  { [ "$TARGET" = local ]; }
on_target() { if is_local; then bash -c "$1"; else ssh_to "$TARGET" "$1"; fi; }

# run_module <workload> <target> <fn> — runs mod_<fn> from the workload's module
# in a subshell, with WORKLOAD, TARGET and HOST set. Missing functions are no-ops.
run_module() {
  local w="$1" target="$2" fn="$3" mod file
  mod=$(workload_module "$w")
  file=$(module_file "$mod") || { warn "$w: no module named '$mod'"; return 2; }
  (
    # shellcheck disable=SC2034  # WORKLOAD, TARGET, HOST are the module interface
    WORKLOAD="$w"; TARGET="$target"; HOST=localhost
    [ "$target" = local ] || HOST=$(machine_host "$target")
    # shellcheck disable=SC1090
    . "$file"
    type "mod_$fn" >/dev/null 2>&1 || exit 0
    "mod_$fn"
  )
}

state_get() { cat "$OFFLOAD_STATE_DIR/$1" 2>/dev/null; }
state_set() { mkdir -p "$(dirname "$OFFLOAD_STATE_DIR/$1")"; printf '%s\n' "$2" > "$OFFLOAD_STATE_DIR/$1"; }

label() { if [ "$1" = local ]; then printf '%s (here)' "$THIS"; elif [ "$1" = none ]; then printf '(nothing)'; else printf '%s' "$1"; fi; }

print_header() {
  local roles
  if [ "$MODE" = off ]; then roles="offloading off"
  elif [ "$THIS" = "$PRIMARY" ]; then roles="$THIS is primary, $WORKER is worker"
  else roles="$THIS is worker for $PRIMARY"; fi
  say "${_c_bld}$THIS${_c_off} · ${_c_bld}$MODE${_c_off} · $roles"
  info "  $MODE_REASON"
}

# ---------------------------------------------------------------- commands

cmd_apply() {
  local w want target prev fb note mark vars envs all_vars="" all_env="" var val line rc
  load_config; detect; print_header

  for w in $(workloads); do
    want=$(resolve_placement "$w"); target="$want"; note=""
    if [ "$target" != local ] && ! ssh_ok "$target"; then
      fb=$(cfg "$w.fallback" local)
      note="$target unreachable"
      if [ "$fb" = local ]; then target=local; note="$note, using $THIS"; else target=none; fi
    fi

    prev=$(state_get "targets/$w")
    if [ -n "$prev" ] && [ "$prev" != "$target" ] && [ "$prev" != none ]; then
      run_module "$w" "$prev" down
    fi

    mark="${_c_grn}✓${_c_off}"
    if [ "$target" != none ]; then
      run_module "$w" "$target" up; rc=$?
      if [ "$rc" -ne 0 ]; then
        mark="${_c_red}✗${_c_off}"; note="${note:+$note; }not ready"
      fi
    else
      mark="${_c_red}✗${_c_off}"
    fi
    state_set "targets/$w" "$target"

    vars=$(run_module "$w" local vars)
    all_vars="$all_vars $vars"
    if [ "$target" != none ]; then
      envs=$(run_module "$w" "$target" env)
      [ -n "$envs" ] && all_env="$all_env
$envs"
    fi
    say "  $(printf '%-10s' "$w") → $(printf '%-18s' "$(label "$target")") $mark${note:+ ${_c_dim}$note${_c_off}}"
  done

  # Write the env file that shells source.
  mkdir -p "$OFFLOAD_STATE_DIR"
  {
    echo "# Generated by 'offload apply' — don't edit. $(date '+%Y-%m-%d %H:%M')"
    echo "export OFFLOAD_CURRENT_MODE=$(shquote "$MODE") OFFLOAD_PRIMARY=$(shquote "$PRIMARY") OFFLOAD_WORKER=$(shquote "$WORKER")"
    for var in $all_vars; do
      line=$(printf '%s\n' "$all_env" | awk -v k="$var=" 'index($0, k) == 1 { print; exit }')
      if [ -n "$line" ]; then
        val="${line#*=}"
        echo "export $var=$(shquote "$val")"
        [ "$(cfg offload.gui_env false)" = true ] && launchctl setenv "$var" "$val" 2>/dev/null
      else
        echo "unset $var"
        [ "$(cfg offload.gui_env false)" = true ] && launchctl unsetenv "$var" 2>/dev/null
      fi
    done
  } > "$OFFLOAD_ENV_FILE.tmp"
  mv "$OFFLOAD_ENV_FILE.tmp" "$OFFLOAD_ENV_FILE"

  keep_awake
}

keep_awake() {
  local pidf="$OFFLOAD_STATE_DIR/caffeinate.pid" pid running=""
  pid=$(cat "$pidf" 2>/dev/null)
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o comm= 2>/dev/null | grep -q caffeinate; then running=1; fi

  if [ "$(cfg offload.keep_awake true)" = true ] && [ -n "$WORKER" ] && [ "$THIS" = "$WORKER" ]; then
    if [ -z "$running" ]; then
      nohup caffeinate -ims >/dev/null 2>&1 &
      echo $! > "$pidf"
      info "  keeping $THIS awake while it's the worker (on AC power)"
    fi
  elif [ -n "$running" ]; then
    kill "$pid" 2>/dev/null; rm -f "$pidf"
    info "  no longer keeping $THIS awake"
  fi
}

cmd_status() {
  local w want current health reach
  load_config; detect; print_header
  for w in $(workloads); do
    want=$(resolve_placement "$w")
    current=$(state_get "targets/$w"); [ -n "$current" ] || current="(not applied)"
    reach=""
    if [ "$want" != local ] && ! ssh_ok "$want"; then reach=" ${_c_red}unreachable${_c_off}"; fi
    if [ "$current" != none ] && [ "$current" != "(not applied)" ] && run_module "$w" "$current" check 2>/dev/null; then
      health="${_c_grn}healthy${_c_off}"
    elif [ "$current" = "(not applied)" ]; then health=""
    else health="${_c_red}not responding${_c_off}"; fi
    say "  $(printf '%-10s' "$w") wants $(printf '%-16s' "$(label "$want")")$reach  now $(label "$current") $health"
  done
}

# Machine-readable: MODE, then one "<workload> <target>" per line. No side effects.
cmd_resolve() {
  local w
  load_config; detect
  echo "mode $MODE"; echo "this $THIS"; echo "primary $PRIMARY"; echo "worker ${WORKER:--}"
  for w in $(workloads); do echo "$w $(resolve_placement "$w")"; done
}

cmd_mode() {
  load_config
  case "${1:-}" in
    "") detect; echo "$MODE"; info "$MODE_REASON" ;;
    auto) rm -f "$OFFLOAD_STATE_DIR/mode"; cmd_apply ;;
    home|away|off) state_set mode "$1"; cmd_apply ;;
    *) die "usage: offload mode [auto|home|away|off]" ;;
  esac
}

# offload ssh [target] [command...] — a shell on another machine, or one command
# there. Target is "primary", "worker", a machine name, or omitted for the other
# machine. Landing on this machine runs locally instead of SSHing to itself.
cmd_ssh() {
  local want target tt=""
  load_config; detect
  if [ $# -gt 0 ]; then want="$1"; shift; else want=other; fi
  [ "${1:-}" = -- ] && shift

  case "$want" in
    other)   target=$(other_machine "$THIS") || die "no other machine in $OFFLOAD_CONFIG" ;;
    primary) target="$PRIMARY" ;;
    worker)  target="${WORKER:-}"
             [ -n "$target" ] || die "no worker right now — mode is $MODE" ;;
    *)       [ -n "$(cfg "machine.$want.role")" ] \
               || die "unknown target '$want' — try primary, worker, or one of: $(machines | tr '\n' ' ')"
             target="$want" ;;
  esac

  if [ "$target" = "$THIS" ]; then
    info "$want is $THIS (here)"
    if [ $# -gt 0 ]; then exec bash -c "$*"; else exec "${SHELL:-/bin/bash}" -l; fi
  fi

  # A tty for sessions and for remote programs that need one, but not when the
  # output is being piped or redirected — that would litter it with CRs.
  [ -t 1 ] && tt="-t"
  # shellcheck disable=SC2086
  exec ssh $tt $OFFLOAD_SSH_INTERACTIVE_OPTS "$(ssh_dest "$target")" "$@"
}

cmd_update() {
  local repo ref tmp
  if [ -d "$OFFLOAD_ROOT/.git" ]; then
    git -C "$OFFLOAD_ROOT" pull --ff-only && ok "updated $OFFLOAD_ROOT"
    return
  fi
  read -r repo ref < "$OFFLOAD_ROOT/.source" 2>/dev/null || die "can't tell where offload was installed from (no $OFFLOAD_ROOT/.source)"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/offload.XXXXXX") || exit 1
  curl -fsSL "https://raw.githubusercontent.com/$repo/$ref/install.sh" -o "$tmp/install.sh" || die "couldn't download the installer"
  OFFLOAD_REPO="$repo" OFFLOAD_REF="$ref" OFFLOAD_HOME="$OFFLOAD_ROOT" /bin/bash "$tmp/install.sh" "$@"
  rm -rf "$tmp"
}

cmd_env() { [ -r "$OFFLOAD_ENV_FILE" ] && cat "$OFFLOAD_ENV_FILE"; }

# Prints the config path so it can be piped: `zed "$(offload config)"`. The path
# is printed whether or not the file exists yet; a missing one is a warning on
# stderr, which keeps the pipe clean.
cmd_config() {
  [ -r "$OFFLOAD_CONFIG" ] || warn "no config at $OFFLOAD_CONFIG yet — run install.sh, or copy config.example.toml there"
  printf '%s\n' "$OFFLOAD_CONFIG"
}

usage() {
  cat <<EOF
offload $OFFLOAD_VERSION — point your tools at whichever Mac should do the work

usage: offload [command]

  apply            detect home/away, route each workload, write the env file (default)
  status           show where everything is and whether it's healthy
  ssh [target]     shell on the other Mac (or: primary | worker | <machine>)
  mode [m]         show the mode, or force one: home | away | off | auto
  setup            one-time setup for this machine (identity, SSH, Docker, sleep)
  doctor           check prerequisites on this machine and the other one
  sync-config      copy this machine's config to the other machine
  autostart on|off re-run apply on login and whenever the network changes
  update           update offload to the latest version
  env              print the generated env file
  config           print the path to the config file (e.g. zed "\$(offload config)")
  resolve          machine-readable routing (for scripts)

config: $OFFLOAD_CONFIG
EOF
}

main() {
  local a cmd="" args=()
  for a in "$@"; do
    # Everything after `offload ssh` is for the remote command, not for us.
    if [ "$cmd" = ssh ]; then args+=("$a"); continue; fi
    case "$a" in
      -q|--quiet) OFFLOAD_QUIET=1 ;;
      -y|--yes) OFFLOAD_YES=1 ;;
      *) if [ -z "$cmd" ]; then cmd="$a"; else args+=("$a"); fi ;;
    esac
  done
  [ -n "$cmd" ] || cmd=apply
  if [ ${#args[@]} -gt 0 ]; then set -- "${args[@]}"; else set --; fi
  case "$cmd" in
    apply) cmd_apply ;;
    status|st) cmd_status ;;
    ssh) cmd_ssh "$@" ;;
    resolve) cmd_resolve ;;
    mode) cmd_mode "$@" ;;
    env) cmd_env ;;
    config) cmd_config ;;
    update) if [ -n "${OFFLOAD_YES:-}" ]; then cmd_update --yes; else cmd_update; fi ;;
    setup) load_config; cmd_setup ;;
    doctor) load_config; cmd_doctor ;;
    sync-config) load_config; cmd_sync_config ;;
    autostart) cmd_autostart "$@" ;;
    version|--version|-v) echo "offload $OFFLOAD_VERSION" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
